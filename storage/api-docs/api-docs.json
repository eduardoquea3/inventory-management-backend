        "/api/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "List products",
                "operationId": "dfc2b785ec51f7bc62dde07a9d10572a",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "description": "Substring filter on name.",
