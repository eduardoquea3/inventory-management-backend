{
    "openapi": "3.0.0",
    "info": {
        "title": "Legacy API",
        "description": "Laravel 8 legacy API. Request and response fields reflect observed controller behavior; optional or weakly validated legacy fields are not represented as guarantees.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Current host"
        }
