                        "description": "Page number; defaults to 1.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated product rows with category and total_movements"
                    },
                    "401": {
                        "description": "Missing or invalid token"
                    },
                    "422": {
                        "description": "Invalid pagination parameters"
                    }
                },
                "security": [
                    {
                        "LegacyTokenAuth": []
                    }
                ]
            },
